# Local API development (when PostgreSQL and Redis are exposed on localhost)
DATABASE_URL=postgresql://tinylink:tinylink_dev_password@localhost:5432/tinylink
REDIS_URL=redis://localhost:6379
API_PORT=4000
BASE_URL=http://localhost:4000
NODE_ENV=development
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=30
