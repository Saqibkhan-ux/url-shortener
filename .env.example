# Postgres
# Local (docker-compose): postgresql://tinylink:tinylink_dev_password@postgres:5432/tinylink
# Render Postgres / Neon / Supabase: use the connection string they give you.
# Most managed Postgres providers require SSL — append ?sslmode=require if
# yours doesn't include it already.
POSTGRES_USER=tinylink
POSTGRES_PASSWORD=tinylink_dev_password
POSTGRES_DB=tinylink
DATABASE_URL=postgresql://tinylink:tinylink_dev_password@postgres:5432/tinylink

# Redis
# Local (docker-compose): redis://redis:6379
# Upstash / Render Redis: use the rediss:// (TLS) URL they give you.
REDIS_URL=redis://redis:6379

# API
API_PORT=4000
BASE_URL=http://localhost:4000
NODE_ENV=development

# Comma-separated list of allowed frontend origins, e.g. your Vercel URL.
# Leave unset locally to allow all origins during development.
CORS_ORIGIN=

# Rate limiting
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=30

# Frontend (set this on Vercel to your deployed Render API URL)
NEXT_PUBLIC_API_URL=http://localhost:4000
